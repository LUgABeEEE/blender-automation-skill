# Normalise line endings *in the repository*; every checkout gets LF.
* text=auto eol=lf

# Binary assets: never normalise, never diff, never try to merge.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated output: keep it out of diffs and out of the language statistics.
dist/** linguist-generated=true
build/** linguist-generated=true
*.egg-info/** linguist-generated=true
